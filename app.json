{
  "expo": {
    "name": "ROSE",
    "slug": "ROSE",
    "version": "1.0.0",
    "scheme": "mi-app-ventas",
    "orientation": "portrait",
    "icon": "./assets/adaptive-icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pachopp.ROSE"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bdcfd287-d7e3-4e84-831f-5e4465b1309e"
      }
    },
    "owner": "pachopp",
    "updates": {
      "url": "https://u.expo.dev/bdcfd287-d7e3-4e84-831f-5e4465b1309e"
    }
  }
}
